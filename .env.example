NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb://localhost:27017/auth-service
MONGODB_AUTH_DB=auth-service

BETTER_AUTH_SECRET=your-super-secret-change-me-in-production-better-auth-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3001

JWT_ISSUER=auth-service
JWT_AUDIENCE=api-gateway

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

JWT_PRIVATE_KEY_PATH=./config/private.key
JWT_PUBLIC_KEY_PATH=./config/public.key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@auth.example.com

JWKS_URL=http://localhost:3001/.well-known/jwks.json

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

LOG_LEVEL=info