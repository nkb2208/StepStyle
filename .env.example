# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/auth-db

# ── Better Auth (credential authority: hashing, reset & verify tokens) ──────
# Must be at least 32 characters.
BETTER_AUTH_SECRET=change-me-to-a-random-string-with-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4000
# Frontend base URL used to build verification / reset links
FRONTEND_URL=http://localhost:4000

# ── JWT (RS256) ─────────────────────────────────────────────────────────────
JWT_ISSUER=auth.yourdomain.com
JWT_AUDIENCE=api.yourdomain.com
# Leave unset to auto-generate a key pair on first boot (persisted to ./config)
# JWT_PRIVATE_KEY_PATH=./config/private.key
# JWT_PUBLIC_KEY_PATH=./config/public.key
# Or provide PEMs directly (use \n for newlines):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Used by downstream services (product / order) to fetch the public keys
JWKS_URL=http://localhost:4000/.well-known/jwks.json

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Email ───────────────────────────────────────────────────────────────────
# memory = capture into an in-process outbox (used by tests)
MAIL_FROM="Auth System <noreply@auth.example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ── Bootstrap admin (first boot only — remove after the first start) ────────
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
