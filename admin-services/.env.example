# ── Core ────────────────────────────────────────────────────────────────────
APP_NAME="StepStyle Admin Service"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=4004
LOG_LEVEL=info

# ── Database — schema created by StepStyle-v2.sql ───────────────────────────
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/stepstyle_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Auth microservice (StepStyle) — stateless RS256 verification ────────────
# Public keys only: downstream services never call the auth service per request.
JWKS_URL=http://localhost:4000/.well-known/jwks.json
# Must match JWT_ISSUER / JWT_AUDIENCE of the auth service.
JWT_ISSUER=auth.yourdomain.com
JWT_AUDIENCE=api.yourdomain.com
CLOCK_TOLERANCE_SECONDS=5
JWKS_REFRESH_SECONDS=60
JWKS_TIMEOUT_SECONDS=5
# true = refuse to boot when the auth service is unreachable (production).
JWKS_FAIL_FAST=false

# ── HTTP ────────────────────────────────────────────────────────────────────
# Comma-separated allow-list.
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ── Business rules ──────────────────────────────────────────────────────────
# Variants at or below this stock level appear in the low-stock dashboard.
LOW_STOCK_THRESHOLD=5
