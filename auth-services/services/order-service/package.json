{
  "name": "@ngocanh-auth/order-service",
  "version": "1.0.0",
  "description": "Example downstream Order service — stateless RS256/JWKS JWT verification, RBAC and M2M (client_credentials) calls to the Product service",
  "type": "module",
  "private": true,
  "main": "./src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ngocanh-auth/auth-express": "*",
    "@ngocanh-auth/auth-types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "mongodb": "^6.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0"
  }
}
