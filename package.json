{
    "name": "ngocanh-auth",
    "version": "1.0.0",
    "description": "Centralized Authentication & Authorization microservice (Node.js, TypeScript, Express, MongoDB, Better Auth) with JWKS-based stateless JWT verification for downstream services",
    "type": "module",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "services/*"
    ],
    "scripts": {
        "dev": "bun --watch services/auth-services/src/server.ts",
        "start": "bun run services/auth-services/src/server.ts",
        "dev:product": "bun run services/product-service/src/server.ts",
        "dev:order": "bun run services/order-service/src/server.ts",
        "build": "bun build services/auth-services/src/server.ts --outdir dist --target node",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ngocanh-auth/auth-express": "*",
        "@ngocanh-auth/auth-types": "*",
        "better-auth": "^1.7.6",
        "concurrently": "^10.0.5",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "express-rate-limit": "^7.4.1",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongodb": "^6.10.0",
        "nodemailer": "^10.0.15",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.9.0",
        "@types/nodemailer": "^6.4.24",
        "mongodb-memory-server": "^10.1.0",
        "typescript": "^5.9.3"
    }
}
