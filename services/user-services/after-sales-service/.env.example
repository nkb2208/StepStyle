# ── Django ──
SECRET_KEY=dev-only-change-me
DEBUG=true

# ── Database (MySQL chạy bằng Docker, map ra cổng 3307) ──
# Lưu ý: DB_HOST chỉ chứa IP/hostname (KHÔNG kèm :3307)
DB_NAME=stepstyle_db
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3307

# ── Inter-service contract: Order Service (Service 4) ──
ORDER_SERVICE_URL=http://127.0.0.1:8000
ORDER_SERVICE_TIMEOUT=5
INTERNAL_API_KEY=

# ── Inter-service contract: Catalog & Search Service (Service 3) ──
CATALOG_SERVICE_URL=http://127.0.0.1:8083
CATALOG_SERVICE_TIMEOUT=3
CATALOG_SYNC_ENABLED=true

# ── Auth service (xác minh JWT bằng JWKS) ──
JWKS_URL=http://localhost:4000/.well-known/jwks.json
JWT_ISSUER=auth.yourdomain.com
JWT_AUDIENCE=api.yourdomain.com

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
